# =============================================================================
# ElectrumX TARCOIN — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# tarcoind RPC credentials
# Must match what tarcoind is started with.
# Use a long random password — this is critical for security.
# ---------------------------------------------------------------------------
TARCOIN_RPC_USER=tarcoin
TARCOIN_RPC_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# ---------------------------------------------------------------------------
# ElectrumX server identity
# Set to your server's public domain name or IP address.
# This is what Electrum clients will see when connecting.
# ---------------------------------------------------------------------------
ELECTRUMX_HOST=electrum.tarcoin.org

# ---------------------------------------------------------------------------
# ElectrumX performance
# Increase CACHE_MB on servers with more RAM (default 1000 = 1GB)
# ---------------------------------------------------------------------------
ELECTRUMX_CACHE_MB=1000
ELECTRUMX_MAX_SESSIONS=1000
