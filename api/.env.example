# TARCOIN REST API — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# Server
PORT=5000
NODE_ENV=production

# TARCOIN Node RPC
RPC_HOST=127.0.0.1
RPC_PORT=19332
RPC_USER=tarcoin
RPC_PASS=your_rpc_password_here

# CORS — set to your frontend domain in production
CORS_ORIGIN=https://tarcoin.org
