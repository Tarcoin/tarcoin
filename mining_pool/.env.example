# TARCOIN Mining Pool — Environment Variables

PORT=3001
NODE_ENV=production

# TARCOIN Node RPC
RPC_HOST=127.0.0.1
RPC_PORT=19332
RPC_USER=tarcoin
RPC_PASS=tarcoin

# Redis
REDIS_URL=redis://localhost:6379

# Pool settings
# Use a fixed payout address from your wallet; do not rely on automatic address generation.
POOL_WALLET=tar1q_your_pool_wallet_address_here
FEE_WALLET=tar1q_your_fee_wallet_address_here
FAUCET_WALLET=faucet
POOL_FEE=1

# Stratum port (hardcoded 3333 in pool.js)
