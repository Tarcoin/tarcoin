{
  "manifest_version": 3,
  "name": "Tarcoin Name Service (TNS)",
  "version": "1.0.0",
  "description": "Seamlessly resolve and browse decentralized .tar domains and IPFS websites natively in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "*://*.tar/*",
    "*://tar/*",
    "https://tarcoin.org/*",
    "https://*.tarcoin.org/*",
    "https://*.pinata.cloud/*"
  ]
}
